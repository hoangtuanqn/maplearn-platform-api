APP_NAME=MapLearn
APP_ENV=local
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=true

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maplearn
DB_USERNAME=root
DB_PASSWORD=


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="MapLearn"


APP_URL=http://localhost:8000
APP_URL_FRONT_END=http://localhost:3000
COOKIE_DOMAIN_PROD=.htuanqn.id.vn


# JWT Token Secret
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
T1_SECRET=xxxxxxxxxxxxxxx

# Infomation Google
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Infomation Facebook
FACEBOOK_CLIENT_ID=xxxxxxxxxxxxxxx
FACEBOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_REDIRECT_URI="${APP_URL}/api/v1/auth/facebook/callback"

# Infomation Discord
DISCORD_CLIENT_ID=xxxxxxxxxxxxxxxxxxx
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_REDIRECT_URI="${APP_URL}/api/v1/auth/discord/callback"

# Setting Info Email
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=xxxxxxxxxxxxxxxxxxxxx
MAIL_PASSWORD=xxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=xxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_NAME="MapLearn - Hệ thống học tập trực tuyến"

# Infomation Pusher
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=xxxxxxx
PUSHER_APP_KEY=xxxxxxxxxxxxxxxxxxxx
PUSHER_APP_SECRET=xxxxxxxxxxxxxxxxxxxx
PUSHER_APP_CLUSTER=ap1
BROADCAST_CONNECTION=pusher

#VNPay
VNPAY_TMN_CODE=xxxxxxxx
VNPAY_HASH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

#Sepay
SEPAY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEPAY_ACCOUNT=xxxxxxxxxxxx

#Momo
MOMO_PARTNER_CODE=xxxxxxxxxxxxxxxxxxxx
MOMO_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
MOMO_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#ZaloPay
ZALOPAY_APP_ID=xxxx
ZALOPAY_KEY1=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZALOPAY_KEY2=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZALOPAY_ENDPOINT=https://sandbox.zalopay.com.vn/v001/tpe/createorder

PASSWORD_DEFAULT_IMPORT=xxxxxxxxxxxxxxxxxxxxxxxx

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
